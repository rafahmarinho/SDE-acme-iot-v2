# Placeholders only — never commit real values (T76). Copy to .env for local dev; set production
# values in Vercel project settings and mark them "Sensitive" (T248).

# ---- Client-safe (bundled into the Expo app; NEVER put secrets here) ----
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
EXPO_PUBLIC_API_BASE_URL=https://<your-api>.vercel.app

# ---- Server-only (Vercel project env vars; never committed, never EXPO_PUBLIC_) ----
# All URLs must be https:// (http://localhost allowed only outside production) — T21/T2599.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<set-in-vercel-dashboard>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"  (>= 32 bytes, T69)
DEVICE_SIM_SHARED_SECRET=<random-32+-bytes>
DEVICE_SIM_BASE_URL=https://<your-api>.vercel.app
# Ed25519 keypair (T60): openssl genpkey -algorithm ed25519 -out fw.pem && openssl pkey -in fw.pem -pubout
FIRMWARE_SIGNING_PRIVATE_KEY=<ed25519-private-key-pem-set-in-vercel>
FIRMWARE_SIGNING_PUBLIC_KEY=<ed25519-public-key-pem>
FIRMWARE_SIGNING_KEY_ID=fw-2026-01
# Exact origins, comma separated, no wildcards (T257)
ALLOWED_ORIGINS=https://<your-web>.vercel.app
# Simulation endpoints are disabled unless explicitly enabled (T49)
ENABLE_SIMULATION=false
# Error details in responses — ignored in production (T49)
DEBUG_ERRORS=false
